rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    
    match /transactions/{transactionId} {
      allow read: if true; 
      allow create: if isValidTransaction(request.resource.data);
      allow update: if isValidTransaction(request.resource.data);
      allow delete: if true; // Enabling client-side deletion as requested
    }

    match /todos/{todoId} {
      allow read: if true;
      allow create: if isValidTodo(request.resource.data);
      allow update: if isValidTodo(request.resource.data);
      allow delete: if true;
    }

    function isValidTodo(data) {
      return data.keys().hasAll(['title', 'completed', 'assignee', 'category', 'date', 'addedBy'])
        && data.keys().size() == 6
        && data.title is string && data.title.size() <= 200
        && data.completed is bool
        && data.assignee is string && data.assignee.size() <= 100
        && data.category is string && data.category.size() <= 100
        && data.date is string && data.date.size() <= 100
        && data.addedBy is string && data.addedBy.size() <= 100;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'type', 'category', 'date', 'description', 'addedBy', 'payer', 'splitWith'])
        && data.keys().size() == 8
        && data.amount is number
        && (data.type == 'income' || data.type == 'expense')
        && data.category is string && data.category.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.date is string && data.date.size() <= 50
        && data.addedBy is string && data.addedBy.size() <= 100
        && data.payer is string && data.payer.size() <= 100
        && data.splitWith is list && data.splitWith.size() <= 3;
    }
  }
}
